{
    "name": "@jtkunley/service-runtime",
    "version": "1.0.0",
    "description": "Request context, graceful shutdown, fatal error handling, and deployment tier checks for Node.js HTTP services.",
    "keywords": [
        "asynclocalstorage",
        "request-context",
        "multi-tenant",
        "graceful-shutdown",
        "sigterm",
        "kubernetes",
        "express",
        "node"
    ],
    "homepage": "https://github.com/jtkunley/service-runtime#readme",
    "bugs": {
        "url": "https://github.com/jtkunley/service-runtime/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jtkunley/service-runtime.git"
    },
    "license": "MIT",
    "author": "jtkunley (https://github.com/jtkunley)",
    "type": "commonjs",
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/prepare-dist.mjs",
        "typecheck": "tsc",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:component": "vitest run --project component",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
        "prepublishOnly": "node -e \"console.error('Publish the built package: npm run build && npm publish dist'); process.exit(1)\""
    },
    "engines": {
        "node": ">=22"
    },
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./tier": {
            "types": "./src/lib/tier/tier.d.ts",
            "default": "./src/lib/tier/tier.js"
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "tier": [
                "./src/lib/tier/tier.d.ts"
            ]
        }
    },
    "files": [
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "express": "^5.3.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    }
}
