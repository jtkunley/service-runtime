{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist/src",
        "types": ["node"],
        "declaration": true,
        "sourceMap": true,
        "inlineSources": true
    },
    "include": ["src"],
    "exclude": ["src/**/__tests__/**", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
